<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Stick Skiing Game</title>
  <style>
    body {
      margin: 0;
      overflow: hidden;
      background-color: #eef;
      font-family: sans-serif;
    }
    #gameCanvas {
      display: block;
      background-color: white;
      border: 2px solid #000;
      margin: 0 auto;
    }
    #ui {
      position: absolute;
      top: 10px;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
    }
    #score, #highscore {
      font-size: 18px;
      margin: 5px;
    }
    #restartBtn, #levelSelect {
      margin-top: 10px;
      padding: 8px 16px;
      font-size: 16px;
    }
  </style>
</head>
<body>
  <div id="ui">
    <div id="score">Score: 0</div>
    <div id="highscore">High Score: 0</div>
    <select id="levelSelect">
      <option value="1">Level 1 (Easy)</option>
      <option value="2">Level 2 (Medium)</option>
      <option value="3">Level 3 (Hard)</option>
    </select>
    <button id="restartBtn">Restart</button>
  </div>
  <canvas id="gameCanvas" width="500" height="600"></canvas>
  <audio id="crashSound" src="https://www.soundjay.com/button/beep-10.mp3"></audio>

  <script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const crashSound = document.getElementById('crashSound');
    const levelSelect = document.getElementById('levelSelect');

    const skier = {
      x: 250,
      y: 500,
      width: 20,
      height: 40,
      speed: 4
    };

    let obstacles = [];
    let keys = {};
    let score = 0;
    let highscore = localStorage.getItem('highscore') || 0;
    let gameOver = false;
    let level = 1;

    document.getElementById('highscore').textContent = `High Score: ${highscore}`;

    function drawSkier() {
      // Head
      ctx.beginPath();
      ctx.arc(skier.x, skier.y - skier.height, 6, 0, Math.PI * 2);
      ctx.fillStyle = 'black';
      ctx.fill();

      // Body
      ctx.beginPath();
      ctx.moveTo(skier.x, skier.y - skier.height + 6);
      ctx.lineTo(skier.x, skier.y);

      // Arms
      ctx.moveTo(skier.x, skier.y - skier.height / 2);
      ctx.lineTo(skier.x - 10, skier.y - skier.height / 2 + 10);
      ctx.moveTo(skier.x, skier.y - skier.height / 2);
      ctx.lineTo(skier.x + 10, skier.y - skier.height / 2 + 10);

      // Legs
      ctx.moveTo(skier.x, skier.y);
      ctx.lineTo(skier.x - 10, skier.y + 10);
      ctx.moveTo(skier.x, skier.y);
      ctx.lineTo(skier.x + 10, skier.y + 10);

      ctx.strokeStyle = 'black';
      ctx.lineWidth = 2;
      ctx.stroke();

      // Skis
      ctx.beginPath();
      ctx.moveTo(skier.x - 12, skier.y + 10);
      ctx.lineTo(skier.x - 18, skier.y + 20);
      ctx.moveTo(skier.x + 12, skier.y + 10);
      ctx.lineTo(skier.x + 18, skier.y + 20);
      ctx.strokeStyle = 'red';
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    function drawObstacle(ob) {
      ctx.fillStyle = 'green';
      ctx.beginPath();
      ctx.moveTo(ob.x + ob.width / 2, ob.y);
      ctx.lineTo(ob.x, ob.y + ob.height);
      ctx.lineTo(ob.x + ob.width, ob.y + ob.height);
      ctx.closePath();
      ctx.fill();
    }

    function resetGame() {
      score = 0;
      skier.x = 250;
      obstacles = [];
      gameOver = false;
      level = parseInt(levelSelect.value);
      skier.speed = 3 + level * 1.2;
      loop();
    }

    function loop() {
      if (gameOver) return;

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (keys['ArrowLeft'] && skier.x - skier.speed > 0) skier.x -= skier.speed;
      if (keys['ArrowRight'] && skier.x + skier.speed < canvas.width) skier.x += skier.speed;

      drawSkier();

      // Obstacles
      if (Math.random() < 0.015 * level) {
        obstacles.push({
          x: Math.random() * (canvas.width - 20),
          y: -30,
          width: 20,
          height: 30
        });
      }

      for (let i = obstacles.length - 1; i >= 0; i--) {
        let ob = obstacles[i];
        ob.y += skier.speed;
        drawObstacle(ob);

        if (
          skier.x < ob.x + ob.width &&
          skier.x + skier.width / 2 > ob.x &&
          skier.y < ob.y + ob.height &&
          skier.y + skier.height > ob.y
        ) {
          crashSound.play();
          gameOver = true;
          if (score > highscore) {
            highscore = score;
            localStorage.setItem('highscore', highscore);
          }
          document.getElementById('highscore').textContent = `High Score: ${highscore}`;
          return;
        }

        if (ob.y > canvas.height) {
          obstacles.splice(i, 1);
          score++;
        }
      }

      document.getElementById('score').textContent = `Score: ${score}`;

      requestAnimationFrame(loop);
    }

    document.addEventListener('keydown', e => {
      if (e.target.tagName !== 'SELECT') {
        keys[e.key] = true;
      }
    });
    document.addEventListener('keyup', e => {
      if (e.target.tagName !== 'SELECT') {
        keys[e.key] = false;
      }
    });
    document.getElementById('restartBtn').addEventListener('click', resetGame);
    levelSelect.addEventListener('change', resetGame);

    loop();
  </script>
</body>
</html>
